let currentPlayer = 1;

const diceFaces = [
  "⚀",
  "⚁",
  "⚂",
  "⚃",
  "⚄",
  "⚅"
];

function rollDice() {

  const diceNumber = Math.floor(Math.random() * 6) + 1;

  document.getElementById("dice").textContent =
    diceFaces[diceNumber - 1];

  document.getElementById("message").textContent =
    `Player ${currentPlayer} rolled ${diceNumber}`;

  currentPlayer++;

  if (currentPlayer > 4) {
    currentPlayer = 1;
  }
}